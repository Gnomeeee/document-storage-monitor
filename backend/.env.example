# PostgreSQL credentials belong only on the backend.
DATABASE_URL="postgresql://dsms_user:CHANGE_ME@localhost:5432/document_storage_monitor?schema=public"
PORT=3000
HOST=127.0.0.1
CLIENT_URL=http://localhost:5173
# Optional comma-separated exact origins; defaults to CLIENT_URL.
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=dsms_backend
MQTT_PASSWORD=CHANGE_ME
MQTT_CLIENT_ID=dsms-backend
# MQTT_CA_FILE=path/to/ca.pem
SIM_MQTT_USERNAME=DOC-ROOM-01
SIM_MQTT_PASSWORD=CHANGE_ME
SIM_DEVICE_CODE=DOC-ROOM-01
# Optional SIM_READING_UID reuses an ID to test identical retries.
# Local testing only: override durations deliberately; defaults match the SRS.
WARNING_AFTER_MS=1800000
CRITICAL_AFTER_MS=900000
HUMIDITY_CLEAR_AFTER_MS=600000
WATER_CLEAR_AFTER_MS=10000
GAP_AFTER_MS=180000
STALE_AFTER_MS=180000
OFFLINE_AFTER_MS=300000
STATUS_INTERVAL_MS=5000
MAX_CONNECTIONS=30
