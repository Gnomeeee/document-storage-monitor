# Public configuration only. Never add database or MQTT credentials here.
VITE_DEVICE_CODE=DOC-ROOM-01
# Optional. By default /ws uses the same host and Vite proxies to port 3000.
# VITE_WS_URL=ws://localhost:3000/ws
# Vite development proxy target (server-side configuration, not a browser secret).
BACKEND_PROXY_TARGET=http://127.0.0.1:3000
